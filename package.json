{
  "name": "munchausen-board-game",
  "version": "1.2.0",
  "private": true,
  "description": "Firebase rules and client sanity tests for Munchausen board game",
  "scripts": {
    "test": "npm run test:static && npm run test:rules",
    "test:static": "node --test test/static.test.js",
    "test:rules": "firebase emulators:exec --only database --project demo-munchausen-board-game \"node --test test/rules.test.js\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase": "13.1.0",
    "firebase-tools": "15.34.2"
  },
  "engines": {
    "node": ">=22"
  }
}
